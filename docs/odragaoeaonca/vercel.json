{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/dragao-onca.webp",
      "destination": "/public/dragao-onca.webp"
    },
    {
      "source": "/dragao-onca-:slug.webp",
      "destination": "/public/dragao-onca-:slug.webp"
    }
  ]
}
