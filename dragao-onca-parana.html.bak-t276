  .litem{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--border)}
  .litem:last-child{border-bottom:none}
  .lnum{font-family:var(--mono);font-size:20px;font-weight:800;min-width:36px;text-align:center;-webkit-text-stroke:1px var(--gr);color:var(--bg3);line-height:1}
  .ltitle{font-size:13px;font-weight:700;color:var(--gr2);margin-bottom:3px}
