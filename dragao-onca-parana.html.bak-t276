  .live-badge{display:inline-flex;align-items:center;gap:5px;background:rgba(74,158,255,0.15);border:1px solid var(--blue-dim);border-radius:4px;padding:3px 10px;font-size:10px;font-weight:700;letter-spacing:1.5px;color:var(--blue2);text-transform:uppercase;margin-left:8px}
