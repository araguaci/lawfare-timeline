<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;500;700;800&family=JetBrains+Mono:wght@400;500&display=swap');
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  :root{
    --bg:#0b0f0a;--bg2:#111a10;--bg3:#182216;
    --gr:#3ecb6f;--gr2:#78f5a8;--gr-dim:#1a6030;
    --red:#e85555;--red2:#ff7575;--red-dim:#7a2020;
    --gold:#e8c44b;--gold2:#f5d87a;--gold-dim:#907820;
    --blue:#4a9eff;--blue2:#7ab8ff;--blue-dim:#1a3d7a;
